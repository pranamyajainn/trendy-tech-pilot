# All customer data stays in this ignored local directory.
PILOT_DATA_DIR=data
PILOT_ASR_MODEL=mlx-community/whisper-large-v3-turbo
# Local Qwen extraction failed development review; method v2 uses PILOT_EXTRACTOR=verified.
PILOT_LLM_MODEL=mlx-community/Qwen3.5-27B-4bit
PILOT_EXTRACTOR=local
# Hosted stages stay off unless explicitly enabled for a run.
PILOT_ALLOW_REMOTE=0
GEMINI_API_KEY=
SARVAM_API_KEY=
# Can only lower MAX_CAP_INR in budget.py; set it to that ceiling explicitly for an approved run.
PILOT_API_CAP_INR=500
# Leave unknown local hardware/electricity costs blank, never assume zero.
PILOT_LOCAL_COMPUTE_INR_PER_HOUR=
